# Never put these keys in frontend environment variables.
# EXPLABS_API_KEY=your-original-finsight-provider-key
# FINSIGHT_AI_MODEL=gpt-6-astra
# FINSIGHT_AI_BASE_URL=https://api.experientiallabs.ai/v1
